'use strict';

const bcrypt = require('bcryptjs');

function id(prefix) {
  return prefix + '_' + Math.random().toString(36).slice(2, 9);
}

function hash(pw) {
  return bcrypt.hashSync(pw, 8);
}

function rand(min, max) {
  return Math.floor(Math.random() * (max - min + 1)) + min;
}

function now() {
  return Date.now();
}

// ---- Automations available to admin accounts (Sales vertical, MVP) ----
const ACTIONS = {
  find_leads: {
    label: 'Read emails & find new leads',
    icon: '📧',
    run(account) {
      const count = rand(1, 4);
      const names = ['Ankit Verma', 'Sara Iqbal', 'Marco Reyes', 'Fatima Noor', 'Declan Shaw', 'Priyanka Rao', 'Tom Halvorsen', 'Wei Chen'];
      const companies = ['Zenith Retail', 'Nova Freight', 'BluePeak Logistics', 'Harbor & Co', 'Crestline Manufacturing', 'Solstice Insurance'];
      const added = [];
      for (let i = 0; i < count; i++) {
        const lead = {
          id: id('lead'),
          name: names[rand(0, names.length - 1)],
          company: companies[rand(0, companies.length - 1)],
          status: 'New',
          source: 'Ina — inbox scan',
          lastContacted: null,
          createdAt: now()
        };
        account.leads.unshift(lead);
        added.push(lead.name);
      }
      return {
        credits: rand(80, 220),
        summary: `Ina scanned the inbox and found ${count} new lead${count === 1 ? '' : 's'}: ${added.join(', ')}.`
      };
    }
  },
  score_leads: {
    label: 'Score leads',
    icon: '🎯',
    run(account) {
      const candidates = account.leads.filter((l) => l.status === 'New' || l.status === 'Contacted');
      const touched = candidates.slice(0, rand(1, Math.min(3, candidates.length || 1)));
      let hot = 0, cold = 0;
      touched.forEach((l) => {
        if (Math.random() > 0.45) { l.status = 'Hot'; hot++; }
        else { l.status = 'Cold'; cold++; }
      });
      return {
        credits: rand(40, 120),
        summary: touched.length
          ? `Ina scored ${touched.length} lead${touched.length === 1 ? '' : 's'} — ${hot} marked hot, ${cold} marked cold.`
          : 'Ina scored the pipeline — no unscored leads left to review.'
      };
    }
  },
  send_followup: {
    label: 'Send follow-up',
    icon: '✉️',
    run(account) {
      const candidates = account.leads.filter((l) => l.status === 'Contacted' || l.status === 'Hot');
      const touched = candidates.slice(0, rand(1, Math.min(3, candidates.length || 1)));
      let converted = 0;
      touched.forEach((l) => {
        l.lastContacted = 'Today';
        if (l.status === 'Hot' && Math.random() > 0.6) { l.status = 'Converted'; converted++; }
      });
      return {
        credits: rand(20, 60),
        summary: touched.length
          ? `Ina sent follow-ups to ${touched.length} lead${touched.length === 1 ? '' : 's'}${converted ? `, ${converted} converted` : ''}.`
          : 'No contacted or hot leads needed a follow-up right now.'
      };
    }
  }
};

function newLead(overrides) {
  return Object.assign({
    id: id('lead'),
    name: 'Lead',
    company: 'Company',
    status: 'New',
    source: 'Manual',
    lastContacted: null,
    createdAt: now()
  }, overrides);
}

function makeSalesAccount(opts) {
  return {
    id: opts.id,
    name: opts.name,
    type: 'sales',
    pipelineLabel: 'Leads',
    statuses: ['New', 'Contacted', 'Hot', 'Cold', 'Converted'],
    status: 'active',
    creditLimit: opts.creditLimit,
    creditsUsed: opts.creditsUsedSeed,
    actionsTriggered: opts.actionsSeed,
    leads: opts.leads,
    team: opts.team,
    activity: opts.activity
  };
}

