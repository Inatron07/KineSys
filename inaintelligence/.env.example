PORT=4100

# Paste the connection string Neon gives you when you create a project.
# It looks like: postgresql://user:password@ep-something.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Any random long string — used to sign the login session cookie.
SESSION_SECRET=change-me-to-something-random

# ── WhatsApp integration (Real Estate CRM tab) ──────────────────────────────
# Leave all of these blank to run without WhatsApp — every other feature
# works fine either way. See public admin.html's "WhatsApp Integration" tab
# for the callback URL + verify token to paste into Meta once these are set.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=choose-a-random-secret-string
OUTREACH_TEMPLATE_NAME=
OUTREACH_TEMPLATE_LANG=en
# Only needed if you run more than one real_estate account — with just one,
# inbound WhatsApp messages are routed to it automatically.
WHATSAPP_ACCOUNT_ID=
# Used by the WhatsApp tab to build the Callback URL shown to copy into
# Meta. On Render this is your service's onrender.com URL (or custom
# domain); leave blank locally and it falls back to the request's own host.
PUBLIC_BASE_URL=

# ── Claude (WhatsApp auto-reply agent) ──────────────────────────────────────
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-5-20250929
AGENT_NAME=Zara
BUSINESS_NAME=KineSys
BUSINESS_CONTEXT="KineSys helps clients buy and rent residential properties across the UAE, working with buyers, renters, and investors, and arranging site visits with our team."
