PORT=3001
EKB_BASE_URL=
EKB_PROJECT_ID=
EKB_API_KEY=
EKB_API_SECRET=
EKB_AGENT_ID=

# Lead-handoff / notification email, sent via Resend's HTTP API
# (works on hosts like Render that block outbound SMTP). Requires a
# domain verified in Resend — see resend.com/domains.
RESEND_API_KEY=re_your_api_key_here
LEAD_NOTIFY_EMAIL=hello@kinesys.net
QUOTE_NOTIFY_EMAIL=hello@kinesys.net
